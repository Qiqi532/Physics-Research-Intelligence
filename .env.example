# Required service connections (replace CHANGE_ME for non-local deployments)
DATABASE_URL=postgresql://pri:CHANGE_ME@127.0.0.1:5432/pri
REDIS_URL=redis://127.0.0.1:6379/0
DAILY_AI_BUDGET_USD=2.50
NEXT_TELEMETRY_DISABLED=1

# AI provider keys are optional for local fact browsing and corpus import.
# Optional master-key file path; keep the real file outside this repository.
AI_SETTINGS_MASTER_KEY_FILE=

# Daily worker schedule
DAILY_PIPELINE_ENABLED=false
DAILY_PIPELINE_TIME=06:00
DAILY_PIPELINE_TIMEZONE=Asia/Shanghai

# Optional public-source identification and higher OpenAlex API allowance
SOURCE_CONTACT_EMAIL=
CROSSREF_ISSN=
OPENALEX_API_KEY=

# Quick AI setup: fill exactly one named provider key; routes, endpoint and model
# then use safe defaults. If more than one key is set, also set AI_DEFAULT_PROVIDER.
AI_DEFAULT_PROVIDER=
AI_PROVIDER_DEEPSEEK_API_KEY=
AI_PROVIDER_OPENAI_API_KEY=
AI_PROVIDER_GEMINI_API_KEY=
AI_PROVIDER_QWEN_API_KEY=
AI_PROVIDER_GLM_API_KEY=
AI_PROVIDER_KIMI_API_KEY=
AI_PROVIDER_HUNYUAN_API_KEY=

# Generic OpenAI Chat Completions-compatible provider (all three are required)
AI_PROVIDER_COMPATIBLE_API_KEY=
AI_PROVIDER_COMPATIBLE_BASE_URL=
AI_PROVIDER_COMPATIBLE_MODEL=

# Optional explicit AI task routing and limits
AI_CLASSIFY_PRIMARY_PROVIDER=
AI_CLASSIFY_PRIMARY_MODEL=
AI_CLASSIFY_FALLBACK_PROVIDER=
AI_CLASSIFY_FALLBACK_MODEL=
AI_INTERPRET_PRIMARY_PROVIDER=
AI_INTERPRET_PRIMARY_MODEL=
AI_INTERPRET_FALLBACK_PROVIDER=
AI_INTERPRET_FALLBACK_MODEL=
AI_REQUEST_TIMEOUT_MS=
AI_CLASSIFY_MAX_OUTPUT_TOKENS=
AI_INTERPRET_MAX_OUTPUT_TOKENS=

# Optional named-provider endpoint, model and USD-per-million-token overrides.
# Repeat these suffixes for DEEPSEEK, OPENAI, GEMINI, QWEN, GLM, KIMI or HUNYUAN.
AI_PROVIDER_GLM_BASE_URL=
AI_PROVIDER_GLM_MODEL=
AI_PROVIDER_GLM_INPUT_COST_PER_MILLION_USD=
AI_PROVIDER_GLM_OUTPUT_COST_PER_MILLION_USD=
