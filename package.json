{
  "name": "physics-research-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "dev": "pnpm --parallel --filter @pri/web --filter @pri/worker dev",
    "lint": "pnpm --recursive --if-present lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
