{
  "name": "@pri/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./ai-repository": "./src/ai-repository.ts",
    "./paper-repository": "./src/paper-repository.ts",
    "./interest-repository": "./src/interest-repository.ts",
    "./today-repository": "./src/today-repository.ts"
  },
  "scripts": {
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:deploy": "prisma migrate deploy --config prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --config prisma.config.ts",
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pri/ai": "workspace:*",
    "@pri/domain": "workspace:*",
    "@pri/recommendation": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "17.4.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0"
  }
}
